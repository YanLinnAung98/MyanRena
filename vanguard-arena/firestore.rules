rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'officeaccxyz@gmail.com'
      );
    }

    function isValidUserPublic(data, userId) {
      return data.keys().hasAll(['uid', 'gameId', 'displayName', 'xp', 'wins', 'losses', 'draws', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'gameId', 'displayName', 'avatarUrl', 'frameId', 'xp', 'wins', 'losses', 'draws', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128
        && data.gameId is string && data.gameId.size() >= 4 && data.gameId.size() <= 20
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 32
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 2048))
        && (!('frameId' in data) || (data.frameId is string && data.frameId.size() <= 64))
        && data.xp is number && data.xp >= 0 && data.xp <= 10000000
        && data.wins is number && data.wins >= 0 && data.wins <= 1000000
        && data.losses is number && data.losses >= 0 && data.losses <= 1000000
        && data.draws is number && data.draws >= 0 && data.draws <= 1000000
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.createdAt is timestamp;
    }

    function isValidMatch(data, matchId) {
      return data.keys().hasAll(['matchId', 'gameType', 'player1Id', 'player2Id', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['matchId', 'gameType', 'player1Id', 'player2Id', 'winnerId', 'status', 'createdAt', 'updatedAt'])
        && data.matchId is string && data.matchId == matchId && data.matchId.size() <= 128
        && data.gameType in ['connect4', 'ttt', 'rps']
        && data.player1Id is string && data.player1Id.size() >= 1 && data.player1Id.size() <= 128
        && data.player2Id is string && data.player2Id.size() >= 1 && data.player2Id.size() <= 128
        && (!('winnerId' in data) || (data.winnerId is string && data.winnerId.size() <= 128))
        && data.status in ['active', 'finished']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFrame(data, frameId) {
      return data.keys().hasAll(['frameId', 'name', 'imageUrl', 'isActive', 'createdAt'])
        && data.keys().hasOnly(['frameId', 'name', 'imageUrl', 'unlockTier', 'isActive', 'createdAt'])
        && data.frameId is string && data.frameId == frameId && data.frameId.size() <= 64
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 64
        && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 2048
        && (!('unlockTier' in data) || (data.unlockTier is string && data.unlockTier.size() <= 32))
        && data.isActive is bool
        && data.createdAt is timestamp;
    }

    function isValidFeatureLock(data) {
      return data.keys().hasAll(['key', 'locked', 'updatedAt'])
        && data.keys().hasOnly(['key', 'locked', 'updatedAt'])
        && data.key is string && data.key.size() >= 2 && data.key.size() <= 32
        && data.locked is bool
        && data.updatedAt is timestamp;
    }

    function isValidTournament(data, tournamentId) {
      return data.keys().hasAll(['tournamentId', 'title', 'gameType', 'status', 'maxPlayers', 'createdAt'])
        && data.keys().hasOnly(['tournamentId', 'title', 'gameType', 'status', 'maxPlayers', 'createdAt'])
        && data.tournamentId is string && data.tournamentId == tournamentId && data.tournamentId.size() <= 128
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 80
        && data.gameType in ['connect4', 'ttt', 'rps']
        && data.status in ['draft', 'registration', 'live', 'completed']
        && data.maxPlayers is number && data.maxPlayers >= 4 && data.maxPlayers <= 64
        && data.createdAt is timestamp;
    }

    // Connection health probe document (safe read-only)
    match /test/connection {
      allow get: if true;
    }

    // Public Player Profiles (no PII)
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.uid is string;
      allow create: if isValidId(userId) && isVerified() && isOwner(userId)
        && isValidUserPublic(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isVerified()
        && isValidUserPublic(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'frameId', 'updatedAt']))
        );
      allow delete: if isValidId(userId) && isAdmin();

      // Strictly Isolated Private PII Subcollection
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isValidId(userId) && isValidId(docId) && isVerified() && isOwner(userId)
          && isValidUserPrivate(incoming(), userId)
          && incoming().createdAt == request.time;
        allow update: if isValidId(userId) && isValidId(docId) && isVerified()
          && isValidUserPrivate(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && (isOwner(userId) || isAdmin())
          && incoming().diff(existing()).affectedKeys().hasOnly(['email']);
        allow delete: if isValidId(userId) && isValidId(docId) && isAdmin();
      }
    }

    // Match History Records
    match /matches/{matchId} {
      allow get: if isValidId(matchId) && isSignedIn()
        && (existing().player1Id == request.auth.uid || existing().player2Id == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.player1Id == request.auth.uid || resource.data.player2Id == request.auth.uid || isAdmin());
      allow create: if isValidId(matchId) && isVerified()
        && isValidMatch(incoming(), matchId)
        && (incoming().player1Id == request.auth.uid || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(matchId) && isVerified()
        && isValidMatch(incoming(), matchId)
        && incoming().matchId == existing().matchId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (existing().status != 'finished'
            && (existing().player1Id == request.auth.uid || existing().player2Id == request.auth.uid)
            && incoming().diff(existing()).affectedKeys().hasOnly(['winnerId', 'status', 'updatedAt']))
        );
      allow delete: if isValidId(matchId) && isAdmin();
    }

    // Decorative Avatar Frames
    match /frames/{frameId} {
      allow get: if isValidId(frameId);
      allow list: if resource.data.isActive == true || isAdmin();
      allow create: if isValidId(frameId) && isAdmin()
        && isValidFrame(incoming(), frameId)
        && incoming().createdAt == request.time;
      allow update: if isValidId(frameId) && isAdmin()
        && isValidFrame(incoming(), frameId)
        && incoming().frameId == existing().frameId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(frameId) && isAdmin();
    }

    // Real-Time Feature & Game Locks
    match /featureLocks/{lockId} {
      allow get: if isValidId(lockId);
      allow list: if resource.data.key is string;
      allow create, update: if isValidId(lockId) && isAdmin()
        && isValidFeatureLock(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(lockId) && isAdmin();
    }

    // Tournaments
    match /tournaments/{tournamentId} {
      allow get: if isValidId(tournamentId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.status is string;
      allow create: if isValidId(tournamentId) && isAdmin()
        && isValidTournament(incoming(), tournamentId)
        && incoming().createdAt == request.time;
      allow update: if isValidId(tournamentId) && isAdmin()
        && isValidTournament(incoming(), tournamentId)
        && incoming().tournamentId == existing().tournamentId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(tournamentId) && isAdmin();
    }

    // Admin registry
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isOwner(adminId);
      allow list, create, update, delete: if false;
    }
  }
}
